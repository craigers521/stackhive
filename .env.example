# StackHive environment template
# Copy to .env and fill in values. All variables are required unless marked optional.

# Flask Dashboard
# Random secret for session signing (e.g. `python3 -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=change-me-to-random-string
# Fernet key for encrypting stored service tokens (e.g. `python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`)
ENCRYPTION_KEY=fernet-key-from-cryptography
# SQLAlchemy database URL; SQLite volume path for single-host deployments
DATABASE_URL=sqlite:////var/lib/stackhive/stackhive.db

# NetBox (create token in NetBox after first boot: User > Tokens)
NETBOX_URL=http://localhost:8080/netbox
NETBOX_TOKEN=
NETBOX_POSTGRES_PASSWORD=netbox
NETBOX_SUPERUSER_NAME=admin
NETBOX_SUPERUSER_EMAIL=admin@stackhive.local
NETBOX_SUPERUSER_PASSWORD=ChangeMe123!
NETBOX_SECRET_KEY=

# GitLab CE
GITLAB_ROOT_PASSWORD=
# Public base URL used by the dashboard (Tools cross-link + MR links); path
# routed through the Traefik unified entry point on :8080
GITLAB_URL=http://localhost:8080/gitlab
# Personal/project access token with `api` scope on the ansible vars project
GITLAB_TOKEN=
# Numeric or full-path project id of the ansible vars repository
GITLAB_PROJECT_ID=
# Shared secret sent as X-GitLab-Token by the CI notify job webhook
GITLAB_SHARED_SECRET=webhook-secret-for-pipeline-callbacks
# Runner registration token (Admin > Instances > Runners), used by the runner container
GITLAB_RUNNER_TOKEN=
# Optional: in-network GitLab API base URL for the runner container
# (default http://gitlab:8090/gitlab — do not set this to your public URL)
GITLAB_RUNNER_URL=

# Grafana
GRAFANA_ADMIN_PASSWORD=
GRAFANA_URL=http://localhost:8080/grafana
# Service account API token with Viewer role
GRAFANA_TOKEN=

# InfluxDB (admin token; org/bucket are auto-created by the image on first boot)
INFLUXDB_TOKEN=
INFLUXDB_ORG=stackhive
INFLUXDB_BUCKET=stackhive-telemetry
INFLUXDB_RETENTION_DAYS=14

# Meraki (optional, for Meraki cloud onboarding)
MERAKI_API_KEY=
MERAKI_DASHBOARD_URL=https://api.meraki.com/api/v1
MERAKI_ORG_ID=

# Ansible / device connectivity (used by preview subprocess and runner jobs)
ANSIBLE_NETCONF_USER=
ANSIBLE_NETCONF_PASSWORD=
ANSIBLE_ENABLE_PASSWORD=

# ZTP base URL must be reachable from managed devices on the network
# (served by Traefik's unified entry point; /ztp is public and unauthenticated)
ZTP_BASE_URL=http://stackhive.local:8080
