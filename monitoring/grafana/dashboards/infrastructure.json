    {
      "id": 5,
      "type": "timeseries",
      "title": "App container resources",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"stackhive-telemetry\")\n  |> range(start: -$__fromTime)\n  |> filter(fn: (r) => r._measurement == \"docker_stats\")\n  |> aggregateWindow(every: 5m, fn: mean, createEmpty: false)",
          "queryType": "randomWalk",
          "resultFormat": "timeSeries"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Container CPU by container",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "custom": { "drawStyle": "line" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"stackhive-telemetry\")\n  |> range(start: -$__fromTime)\n  |> filter(fn: (r) => r._measurement == \"docker_stats\" and r._field == \"cpu_percent\")\n  |> aggregateWindow(every: 5m, fn: mean, createEmpty: false)",
          "queryType": "randomWalk",
          "resultFormat": "timeSeries"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Container memory by container",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "custom": { "drawStyle": "line" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"stackhive-telemetry\")\n  |> range(start: -$__fromTime)\n  |> filter(fn: (r) => r._measurement == \"docker_stats\" and r._field == \"memory_percent\")\n  |> aggregateWindow(every: 5m, fn: mean, createEmpty: false)",
          "queryType": "randomWalk",
          "resultFormat": "timeSeries"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Disk usage by mount",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "drawStyle": "line" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"stackhive-telemetry\")\n  |> range(start: -$__fromTime)\n  |> filter(fn: (r) => r._measurement == \"disk\" and r._field == \"used_percent\")\n  |> aggregateWindow(every: 5m, fn: max, createEmpty: false)",
          "queryType": "randomWalk",
          "resultFormat": "timeSeries"
        }
      ]
    }
