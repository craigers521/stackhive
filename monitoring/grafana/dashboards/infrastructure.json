{
  "uid": "stackhive-infrastructure",
  "title": "Infrastructure",
  "tags": ["stackhive", "infrastructure"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "netbox",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"stackhive-telemetry\") |> range(start: -15m) |> filter(fn: (r) => r._measurement == \"service_health\" and r.service == \"netbox\") |> last()",
          "queryType": "randomWalk",
          "resultFormat": "timeSeries"
        }
      ],
      "alert": {
        "alertRuleTags": { "service": "netbox" },
        "conditions": [
          {
            "evaluator": { "params": [1], "type": "lt" },
            "operator": { "type": "and" },
            "query": { "params": ["A", "2m", "now"] },
            "reducer": { "type": "last" },
            "type": "query"
          }
        ],
        "executionErrorState": "no_data",
        "for": "2m",
        "frequency": "1m",
        "handler": 1,
        "message": "netbox service health is not reporting up.",
        "name": "netbox availability",
        "noDataState": "alerting",
        "notifications": []
      }
    },
